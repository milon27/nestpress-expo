{
    "name": "nestpress-expo",
    "main": "expo-router/entry",
    "version": "1.0.0",
    "scripts": {
        "start": "expo start",
        "dev": "expo start --reset-cache",
        "reset-project": "node ./scripts/reset-project.js",
        "android": "expo start --android",
        "ios": "expo start --ios",
        "web": "expo start --web",
        "lint": "expo lint",
        "local:apk:build": "eas build --platform android --profile development --local",
        "eas:apk:build": "eas build --platform android --profile development",
        "local:aab:build": "eas build --platform android --profile production --local",
        "eas:aab:build": "eas build --platform android --profile production",
        "web:build": "expo export -p web",
        "web:serve": "npx serve dist --single",
        "docker:dev": "docker compose  -f docker-compose.dev.yml up --build",
        "ts:check": "tsc"
    },
    "dependencies": {
        "@expo/metro-runtime": "~6.1.2",
        "@expo/vector-icons": "^15.0.2",
        "@react-native-async-storage/async-storage": "^2.2.0",
        "@react-navigation/bottom-tabs": "^7.4.0",
        "@react-navigation/elements": "^2.6.3",
        "@react-navigation/native": "^7.1.8",
        "@tanstack/query-async-storage-persister": "^5.90.2",
        "@tanstack/react-query": "^5.90.2",
        "@tanstack/react-query-persist-client": "^5.90.2",
        "axios": "^1.12.2",
        "better-auth": "^1.3.24",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "expo": "~54.0.10",
        "expo-constants": "~18.0.9",
        "expo-font": "~14.0.8",
        "expo-haptics": "~15.0.7",
        "expo-image": "~3.0.8",
        "expo-linking": "~8.0.8",
        "expo-router": "~6.0.8",
        "expo-splash-screen": "~31.0.10",
        "expo-status-bar": "~3.0.8",
        "expo-symbols": "~1.0.7",
        "expo-system-ui": "~6.0.7",
        "expo-web-browser": "~15.0.7",
        "nativewind": "^4.2.1",
        "prettier-plugin-tailwindcss": "^0.5.14",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "react-native": "0.81.4",
        "react-native-gesture-handler": "~2.28.0",
        "react-native-reanimated": "~3.17.4",
        "react-native-safe-area-context": "^5.4.0",
        "react-native-screens": "~4.16.0",
        "react-native-web": "~0.21.0",
        "react-native-worklets": "0.5.1",
        "tailwind-merge": "^3.3.1",
        "tailwindcss": "^3.4.17",
        "zod": "3.25.76",
        "zustand": "^5.0.5"
    },
    "devDependencies": {
        "@types/react": "~19.1.0",
        "eslint": "^9.25.0",
        "eslint-config-expo": "~10.0.0",
        "typescript": "~5.9.2"
    },
    "private": true,
    "packageManager": "yarn@4.10.3"
}
