{
    "name": "nestpress-expo",
    "main": "expo-router/entry",
    "version": "1.0.0",
    "scripts": {
        "start": "expo start",
        "dev": "expo start --reset-cache",
        "reset-project": "node ./scripts/reset-project.js",
        "android": "expo start --android",
        "ios": "expo start --ios",
        "web": "expo start --web",
        "lint": "expo lint",
        "local:apk:build": "eas build --platform android --profile development --local",
        "eas:apk:build": "eas build --platform android --profile development",
        "local:aab:build": "eas build --platform android --profile production --local",
        "eas:aab:build": "eas build --platform android --profile production",
        "web:build": "expo export -p web",
        "web:serve": "npx serve dist --single",
        "docker:dev": "docker compose  -f docker-compose.dev.yml up --build",
        "ts:check": "tsc",
        "sitemap": "npx expo-router-sitemap"
    },
    "dependencies": {
        "@expo/metro-runtime": "~57.0.8",
        "@expo/vector-icons": "^15.0.2",
        "@hookform/resolvers": "^5.2.2",
        "@react-native-async-storage/async-storage": "^2.2.0",
        "@react-navigation/bottom-tabs": "^7.4.0",
        "@react-navigation/elements": "^2.6.3",
        "@react-navigation/native": "^7.1.8",
        "@tanstack/query-async-storage-persister": "^5.90.2",
        "@tanstack/react-query": "^5.90.2",
        "@tanstack/react-query-persist-client": "^5.90.2",
        "axios": "^1.12.2",
        "better-auth": "^1.3.24",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "expo": "~57.0.10",
        "expo-constants": "~57.0.9",
        "expo-font": "~57.0.1",
        "expo-haptics": "~57.0.1",
        "expo-image": "~57.0.2",
        "expo-linking": "~57.0.5",
        "expo-router": "~57.0.10",
        "expo-splash-screen": "~57.0.5",
        "expo-status-bar": "~57.0.1",
        "expo-symbols": "~57.0.1",
        "expo-system-ui": "~57.0.2",
        "expo-web-browser": "~57.0.2",
        "nativewind": "^4.2.1",
        "prettier-plugin-tailwindcss": "^0.5.14",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-hook-form": "^7.63.0",
        "react-native": "0.86.2",
        "react-native-gesture-handler": "~2.32.0",
        "react-native-reanimated": "4.5.1",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-screens": "~4.26.0",
        "react-native-web": "^0.21.2",
        "react-native-worklets": "0.10.1",
        "tailwind-merge": "^3.3.1",
        "tailwindcss": "^3.4.17",
        "zod": "3.25.76",
        "zustand": "^5.0.5"
    },
    "devDependencies": {
        "@babel/core": "^7.27.0",
        "@react-native/metro-config": "^0.86.2",
        "@types/react": "~19.2.4",
        "eslint": "^9.25.0",
        "eslint-config-expo": "~57.0.1",
        "prettier": "^3.9.6",
        "typescript": "~6.0.3"
    },
    "private": true,
    "packageManager": "yarn@4.10.3"
}
